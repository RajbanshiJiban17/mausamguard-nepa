# MausamGuard Nepal - Environment Configuration
PROJECT_NAME="MausamGuard Nepal"
PROJECT_SUBTITLE="Real-Time Flood, Landslide & Agriculture Risk Monitoring and Early Warning Decision Support System for Nepal"
ENVIRONMENT=development
DEBUG=false

# Database Configuration
# Default to SQLite for seamless local execution on Windows without external dependencies.
# For production PostgreSQL / PostGIS: postgresql://postgres:postgres@localhost:5432/mausamguard
DATABASE_URL=sqlite:///./mausamguard.db

# Optional Redis Cache (falls back gracefully to in-memory cache if unavailable)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
JWT_SECRET=mausamguard_secret_change_in_production_key_nepal_hazard_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# External API Feeds
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DHM_BASE_URL=https://hydrology.gov.np

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Operational Modes
DEMO_MODE=false
PRODUCTION_MODE=false
RATE_LIMIT_DEFAULT=120/minute

# Dataset Directory Path (relative or absolute)
DATA_DIR=data/processed
